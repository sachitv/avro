{
  "name": "avro-js",
  "version": "1.13.0-SNAPSHOT",
  "author": "Avro Developers <dev@avro.apache.org>",
  "description": "JavaScript Avro implementation",
  "contributors": [
    {
      "name": "Matthieu Monsch",
      "email": "monsch@alum.mit.edu"
    },
    {
      "name": "Quinn Slack",
      "email": "sqs@cs.stanford.edu"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apache/avro"
  },
  "keywords": [
    "avro",
    "json"
  ],
  "type": "module",
  "files": [
    "LICENSE",
    "NOTICE",
    "lib",
    "etc/browser",
    "etc/deprecated/validator.js"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./etc/browser/*": "./etc/browser/*.js",
    "./etc/deprecated/*": "./etc/deprecated/*.js"
  },
  "browser": {
    "./lib": "./lib/index.js",
    "crypto": "./etc/browser/crypto.js",
    "path": "./etc/browser/path.js",
    "buffer": "./etc/browser/buffer.js",
    "./lib/hash.js": "./etc/browser/hash.js",
    "stream": "stream-browserify",
    "./lib/zlib.js": "./etc/browser/zlib.js"
  },
  "scripts": {
    "cover": "nyc npm run test",
    "test": "mocha --fgrep interop --invert",
    "clean": "rm -rf coverage node_modules",
    "lint": "jshint lib test",
    "interop-data-generate": "node test/interop_data_generate.js",
    "interop-data-test": "mocha test/interop_data_test.js"
  },
  "dependencies": {
    "pako": "^2.1.0",
    "stream-browserify": "^3.0.0",
    "underscore": "^1.13.2"
  },
  "devDependencies": {
    "nyc": "^17.0.0",
    "coveralls": "^3.1.1",
    "jshint": "^2.13.4",
    "mocha": "11.7.4",
    "tmp": "^0.2.1"
  },
  "noAnalyze": true,
  "license": "Apache-2.0",
  "engine": {
    "node": ">=0.11"
  }
}
